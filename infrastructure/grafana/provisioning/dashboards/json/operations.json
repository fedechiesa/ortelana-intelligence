    {
      "id": 12,
      "title": "Successful processing / waiting review (%)",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ortelana-pg"
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT 100.0 * COUNT(*) FILTER(WHERE technical_status IN ('COMPLETED','WAITING_REVIEW')) / NULLIF(COUNT(*),0) AS success_percent FROM executions",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "sql": {
            "columns": [],
            "groupBy": [],
            "limit": 1000
