          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      }
    },
    {
      "id": 5,
      "title": "Mean execution latency (seconds)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "ortelana-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(ortelana_execution_seconds_sum[5m]) / rate(ortelana_execution_seconds_count[5m])",
          "legendFormat": "{{outcome}}"
