      "typeVersion": 4.2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "http://backend:8000/analizar",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Idempotency-Key",
              "value": "={{ $('Prepare request').first().json.idempotency_key }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({anio_base: $('Prepare request').first().json.anio_base, anio_actual: $('Prepare request').first().json.anio_actual, producto_id: $('Prepare request').first().json.producto_id || null}) }}",
        "options": {
          "timeout": 45000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "ortelanaApiHeader",
          "name": "Ortelana API automation"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
