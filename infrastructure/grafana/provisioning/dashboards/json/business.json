          "rawSql": "SELECT e.id AS execution, item->>'name' AS product, (item->>'variation')::numeric AS matched_change_percent, item->>'status' AS risk, item->>'coverage_pct' AS coverage_percent FROM executions e CROSS JOIN LATERAL json_array_elements(e.result->'products') item WHERE item->>'status' IN ('ADVERTENCIA','CRITICO') ORDER BY e.created_at DESC LIMIT 100",
