  "panels": [
    {
      "id": 1,
      "title": "Observed reporting-year metres (latest imported snapshot)",
      "type": "barchart",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ortelana-pg"
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT year::text AS reporting_year, SUM(total) AS metres FROM sales WHERE dataset_id=(SELECT id FROM datasets ORDER BY created_at DESC LIMIT 1) GROUP BY year ORDER BY year",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "sql": {
            "columns": [],
            "groupBy": [],
            "limit": 1000
          }
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
