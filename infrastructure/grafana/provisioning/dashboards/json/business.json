          "rawSql": "SELECT b.name, SUM(s.total) AS metres FROM sales s JOIN branches b ON b.id=s.branch_id AND b.dataset_id=s.dataset_id WHERE s.dataset_id=(SELECT id FROM datasets ORDER BY created_at DESC LIMIT 1) AND s.year=(SELECT MAX(year) FROM sales WHERE dataset_id=(SELECT id FROM datasets ORDER BY created_at DESC LIMIT 1)) GROUP BY b.name ORDER BY 2 DESC",
